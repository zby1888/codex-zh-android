 static INSTALL_CONTEXT: OnceLock<InstallContext> = OnceLock::new();
+
+// Android 10+ launches app-private ELF binaries through linker64. In that
+// mode std::env::current_exe() can resolve to /system/bin/linker64 instead
+// of the Codex ELF. The Android launcher supplies the real executable path.
+fn current_executable_path() -> Option<PathBuf> {
+    #[cfg(target_os = "android")]
+    if let Some(path) = std::env::var_os("TERMUX_EXEC__PROC_SELF_EXE") {
+        let path = PathBuf::from(path);
+        if path.is_absolute() && path.is_file() {
+            return Some(path);
+        }
+    }
+    std::env::current_exe().ok()
+}
